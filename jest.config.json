{
  "preset": "react-native",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(js|ts|tsx)$": "babel-jest"
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
  "moduleNameMapper": {
    "\\.(css|scss|sass|less)$": "<rootDir>/__mocks__/styleMock.js"
  },
  "setupFilesAfterEnv": [],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/", "/build/"],
  "globals": {}
}
